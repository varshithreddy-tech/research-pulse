GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# check ai.google.dev/gemini-api/docs/pricing — rate changes 1 Jan 2027
GEMINI_PRICE_INPUT_PER_M=0.75
GEMINI_PRICE_OUTPUT_PER_M=3.75
TAVILY_API_KEY=
DATABASE_URL=
RESEND_API_KEY=
KAVITA_EMAIL=
# Both required — the app refuses to build or start if either is empty
CRON_SECRET=
DASHBOARD_PASSWORD=
SEMANTIC_SCHOLAR_API_KEY=

# Optional tuning
# GEMINI_THINKING_LEVEL=low       for gemini-3.8-flash: no extra thinking tokens ("minimal" is not supported)
# GEMINI_CONCURRENCY=3        parallel Gemini calls (lower it on the free tier)
# ARXIV_BACKFILL_DAYS=2       days to fetch the very first time a category is seen
# APP_URL=                    dashboard URL used in the email (defaults to the Vercel production URL)
